# CircleCI personal API token (org: nickbrett1). Consumed by the CircleCI CLI
# MCP server and by circleci_server.py via CIRCLE_TOKEN. Copy this file to
# .env on the NAS (chmod 600) and fill in the real value. Never commit .env.
CIRCLE_TOKEN=

# Pin the CircleCI CLI version used to build the image (Dockerfile ARG).
# Bump here + in the Dockerfile, then re-publish to update.
CIRCLECI_CLI_VERSION=v1.0.48692
